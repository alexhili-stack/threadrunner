; Threadrunner - Godot 4.7.2
config_version=5

[application]
config/name="Threadrunner"
run/main_scene="res://scenes/app/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/art/icon.svg"
config/use_custom_user_dir=true
config/custom_user_dir_name="Threadrunner"

[display]
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/min_width=640
window/size/min_height=360
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.015, 0.017, 0.02, 1)
textures/default_filters/use_nearest_mipmap_filter=false

[physics]
common/physics_ticks_per_second=60

[input_devices]
joypads/ignore_joypad_on_unfocused_application=true

[debug]
gdscript/warnings/untyped_declaration=1
